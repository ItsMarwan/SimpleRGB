<UserControl x:Class="SimpleRGB.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Small round color swatch button -->
        <ControlTemplate x:Key="SwatchTemplate" TargetType="Button">
            <Border x:Name="B" Width="22" Height="22" CornerRadius="11" Background="{Binding}" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,0,6,6" />
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="B" Property="BorderBrush" Value="White" />
                    <Setter TargetName="B" Property="BorderThickness" Value="2" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
        <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MaxLength" Value="3" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Saturation / brightness -->
        <Border CornerRadius="12" ClipToBounds="True" Height="180">
            <Grid x:Name="SvArea" Background="Transparent" Cursor="Cross"
                  MouseLeftButtonDown="SvArea_MouseDown" MouseMove="SvArea_MouseMove" MouseLeftButtonUp="Area_MouseUp">
                <Grid.Clip>
                    <RectangleGeometry x:Name="SvClip" RadiusX="12" RadiusY="12" />
                </Grid.Clip>
                <Rectangle x:Name="HueFill" Fill="Red" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SvThumb" Width="20" Height="20" Stroke="White" StrokeThickness="3">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.8" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Border>

        <!-- Hue -->
        <Grid x:Name="HueArea" Height="24" Margin="0,14,0,0" Background="Transparent" Cursor="Hand"
              MouseLeftButtonDown="HueArea_MouseDown" MouseMove="HueArea_MouseMove" MouseLeftButtonUp="Area_MouseUp">
            <Border Height="14" CornerRadius="7" Background="{StaticResource RainbowBrush}" VerticalAlignment="Center" />
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="HueThumb" Width="22" Height="22" Canvas.Top="1" Fill="Red" Stroke="White" StrokeThickness="3">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.7" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- Values -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Preview" Width="32" Height="32" CornerRadius="16" Background="Red" BorderBrush="#33FFFFFF" BorderThickness="1" />
            <TextBox x:Name="HexBox" Grid.Column="1" Margin="10,0,8,0" MaxLength="7" Height="32" Padding="10,0"
                     FontFamily="Cascadia Mono, Consolas" CharacterCasing="Upper" VerticalContentAlignment="Center"
                     KeyDown="Box_KeyDown" LostKeyboardFocus="HexBox_LostFocus" ToolTip="Hex color, e.g. #00A2FF" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBox x:Name="RBox" Style="{StaticResource NumBox}" ToolTip="Red 0-255" KeyDown="Box_KeyDown" LostKeyboardFocus="Rgb_LostFocus" />
                <TextBox x:Name="GBox" Style="{StaticResource NumBox}" ToolTip="Green 0-255" Margin="4,0" KeyDown="Box_KeyDown" LostKeyboardFocus="Rgb_LostFocus" />
                <TextBox x:Name="BBox" Style="{StaticResource NumBox}" ToolTip="Blue 0-255" KeyDown="Box_KeyDown" LostKeyboardFocus="Rgb_LostFocus" />
            </StackPanel>
        </Grid>

        <!-- Swatches -->
        <TextBlock Text="QUICK COLORS" Style="{StaticResource SectionLabel}" Margin="0,16,0,8" />
        <ItemsControl x:Name="Presets" ItemsPanel="{StaticResource WrapPanelTemplate}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Template="{StaticResource SwatchTemplate}" Click="Swatch_Click" Tag="{Binding}" ToolTip="{Binding}" Cursor="Hand" Focusable="False" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,8,0,8">
            <TextBlock Text="FAVORITES" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="8,2" Click="AddFavorite_Click" ToolTip="Save the current color">
                <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Accent}"><Run Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10" /> Save color</TextBlock>
            </Button>
        </Grid>
        <TextBlock x:Name="NoFavorites" Style="{StaticResource Caption}" Text="Colors you save show up here. Right-click one to remove it." TextWrapping="Wrap" Margin="0,0,0,6" />
        <ItemsControl x:Name="FavoritesList" ItemsPanel="{StaticResource WrapPanelTemplate}"
                      ItemsSource="{Binding Favorites, ElementName=Root}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Template="{StaticResource SwatchTemplate}" Click="Swatch_Click" Tag="{Binding}" ToolTip="{Binding}" Cursor="Hand" Focusable="False"
                            MouseRightButtonUp="Favorite_RightClick" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel x:Name="RecentPanel">
            <TextBlock Text="RECENT" Style="{StaticResource SectionLabel}" Margin="0,8,0,8" />
            <ItemsControl ItemsPanel="{StaticResource WrapPanelTemplate}" ItemsSource="{Binding Recents, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Template="{StaticResource SwatchTemplate}" Click="Swatch_Click" Tag="{Binding}" ToolTip="{Binding}" Cursor="Hand" Focusable="False" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
