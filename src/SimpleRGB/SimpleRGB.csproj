<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>Assets\SimpleRGB.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SimpleRGB</AssemblyName>
    <Product>SimpleRGB</Product>
    <Version>1.0.0</Version>
    <Description>Simple, lightweight RGB lighting control.</Description>
    <Authors>ItsMarwan</Authors>
    <Copyright>Copyright (C) 2026 ItsMarwan. Licensed under GPL-3.0.</Copyright>
    <RepositoryUrl>https://github.com/ItsMarwan/SimpleRGB</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpleRGB.Core\SimpleRGB.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SimpleRGB.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <!-- Avoid ambiguity between WPF and WinForms types (WinForms is only used for the tray icon). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
